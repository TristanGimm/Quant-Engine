# Copy to .env and chmod 600 .env. Never commit .env.
CTRADER_ENV=demo
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCOUNT_ID=
CTRADER_SYMBOL=XAUUSD
# Original engine cadence: 50 ms. Values of Hurst/OU depend on this sampling interval.
SAMPLE_INTERVAL_SECONDS=0.05
# Hurst alone selects the regime. Neutral includes both boundaries.
HURST_MEAN_REVERSION_BELOW=0.4
HURST_TREND_ABOVE=0.6
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
# Leave TOKEN_FILE unset for normal Docker operation.
ACME_EMAIL=
DASHBOARD_USER=quant

# Generate: python scripts/dashboard-password.py; required for Docker.
DASHBOARD_LOGIN_HASH=
DASHBOARD_COOKIE_SECURE=true
